class Inmobiliaria {
    #edificios = [];

    addEdificio(edificio) {
        this.#edificios.push(edificio);
    }

    getEdificio(calle, numero) {
        return this.#edificios.find(e => e.calle === calle && e.numero === numero) || null;
    }
}

